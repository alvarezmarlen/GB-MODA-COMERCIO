    "descriptions": {
      "america_central": "منطقة نابضة بالحياة تحافظ على فن النول المايوي القديم والفخار متعدد الألوان والمهن المقدسة في تناغم تام مع الغابات العميقة والبراكين المهيبة.",
      "pais_vasco": "مستوطنة تاريخية لا مثيل لها حيث حدد غزل الألياف النباتية الدقيق والحدادة الحرفية وبناء السفن الدقيق هوية فريدة، محفوظة بعناية من قبل أساتذة شغوفين.",
      "espana": "ملتقى طرق وتناقضات، غنية بشكل هائل بالتقاليد النسيجية القديمة والخياطة الكلاسيكية الراقية ومهارات الجلود الناعمة التي استمرت عبر القرون في زوايا شبه الجزيرة المختلفة.",
      "marruecos": "موطن صوفي للفخار الأحمر القديم من جبال الريف، ودباغين بارعين في المدن الإمبراطورية، وأنوال بألوان مستحيلة. إرث نابض بالحياة، مصنوع يدوياً بالكامل ومنقول من الأمهات إلى البنات.",
      "africa": "القارة الأفريقية الشاسعة هي المهد البدائي لتقنيات نسج لا تعد ولا تحصى، واستخراج الأصباغ العضوية الترابية، والمهن المحلية المتطورة دائماً من احترام عميق وحيوي للطبيعة.",
      "otro": "من دقة الحرير التي لا تشوبها شائبة في الشرق الأقصى إلى نحت الخشب الطقسي المهيب في أوقيانوسيا، نستكشف خطوط عرض أخرى حيث تستمر العبقرية البشرية في نسج التاريخ في الوقت الحقيقي."
    }
  },
